+        match (aws, scytale) {
+            // Each against itself, and each against the other.
+            (Some(aws), Some(scytale)) => Some(vec![
+                (aws, aws),
+                (scytale, scytale),
+                (aws, scytale),
+                (scytale, aws),
+            ]),
+            (Some(aws_suite), None) => Some(vec![(aws_suite, aws_suite)]),
+            (None, Some(scytale)) => Some(vec![(scytale, scytale)]),
