+/// Every suite rustls-scytale has, P-384 and SHA-384 included, which
+/// the vectors above do not cover: each provider's keys, sealed by
+/// one and opened by the other.
+#[test]
+fn scytale_and_aws_lc_rs_agree() {
+    let mut checked = 0;
+    for ours in rustls_scytale::hpke::ALL_SUPPORTED_SUITES {
+        let Some(theirs) =
+            TestVector::lookup_suite(ours.suite(), rustls_aws_lc_rs::hpke::ALL_SUPPORTED_SUITES)
+        else {
+            continue;
+        };
+        for (keys, sealer, opener) in [(*ours, *ours, theirs), (theirs, theirs, *ours), (*ours, theirs, *ours), (theirs, *ours, theirs)] {
+            let (public, secret) = keys.generate_key_pair().unwrap();
+            let (enc, ct) = sealer.seal(b"info", b"aad", b"message", &public).unwrap();
+            let pt = opener.open(&enc, b"info", b"aad", &ct, &secret).unwrap();
+            assert_eq!(pt, b"message", "{:?}", ours.suite());
+        }
+        checked += 1;
+    }
+    assert_eq!(checked, 12);
+}
+
